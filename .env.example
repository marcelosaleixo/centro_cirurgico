# Copie os valores para as variáveis do sistema/EasyPanel. Não versione segredos.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/centro_cirurgico
DB_USERNAME=postgres
DB_PASSWORD=DEFINA_A_SENHA_REAL_DO_BANCO
RH_ADMIN_USERNAME=admin.rh
RH_ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES
SESSION_TIMEOUT=15m
SESSION_COOKIE_SECURE=false
SHOW_SQL=false
FORMAT_SQL=false
THYMELEAF_CACHE=true
DEVTOOLS_RESTART=false
DEVTOOLS_LIVERELOAD=false
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
HIBERNATE_SQL_LOG_LEVEL=WARN
# Em produção com HTTPS, altere SESSION_COOKIE_SECURE=true

# Backup PostgreSQL (use somente no ambiente que executa os scripts)
DB_HOST=HOST_INTERNO_POSTGRES
DB_PORT=5432
DB_NAME=centro_cirurgico
DB_USERNAME=USUARIO_DO_BANCO
DB_PASSWORD=SENHA_DO_BANCO
BACKUP_DIR=./backups

# Rotina automatizada de backup (configure no serviço de tarefas, não no app web)
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/backups
